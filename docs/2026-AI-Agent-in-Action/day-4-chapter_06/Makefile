.PHONY: help install \
	first-btree second-btree \
	행동트리1 행동트리2 행동트리3 \
	가드 데코레이터 리액티브 시각화 \
	sk-btree sk-btree2 \
	재사용의미학

help: ## 사용 가능한 명령어 목록 출력
	@echo ""
	@echo "=== Chapter 06 - 행동 트리 (Behavior Tree) 실습 ==="
	@echo ""
	@grep -E '^[a-zA-Z0-9가-힣_-]+:.*##' $(MAKEFILE_LIST) | \
		awk -F ':.*## ' '{printf "  \033[36m%-24s\033[0m %s\n", $$1, $$2}'
	@echo ""

# ──────────────────────────────────────────────
# 환경 설정
# ──────────────────────────────────────────────

install: ## 실습에 필요한 모든 패키지 설치 (uv)
	uv pip install -r requirements.txt

# ──────────────────────────────────────────────
# 1단계: 행동 트리 기초 (py_trees 입문)
# ──────────────────────────────────────────────

first-btree: ## [1] py_trees 기본 - Selector/Sequence 구조, tick 실행
	uv run python first_btree.py

second-btree: ## [1] 블랙보드 도입 - 노드 간 공유 데이터 저장소
	uv run python second_btree.py

# ──────────────────────────────────────────────
# 2단계: 행동 트리 심화 (블랙보드 활용)
# ──────────────────────────────────────────────

행동트리1: ## [2] 블랙보드 기반 상태 전파 - 검색 → 평가 → 응답 파이프라인
	uv run python 행동트리1.py

행동트리2: ## [2] 다단계 에이전트 - 검색/평가/응답 노드 + Selector 분기
	uv run python 행동트리2.py

행동트리3: ## [2] 동적 분기 - 블랙보드 조건에 따른 실행 경로 전환
	uv run python 행동트리3.py

# ──────────────────────────────────────────────
# 3단계: 고급 패턴 (가드, 데코레이터, 리액티브)
# ──────────────────────────────────────────────

가드: ## [3] Guard 패턴 - 실행 전 사전 조건 검증 (API 키 체크)
	uv run python 가드.py

데코레이터: ## [3] Decorator 패턴 - 노드 결과 반전/재시도 래핑
	uv run python 데코레이터.py

리액티브: ## [3] Reactive 패턴 - 매 틱마다 조건 재평가
	uv run python 리액티브.py

시각화: ## [3] 트리 시각화 - py_trees 트리 구조를 텍스트/그래프로 출력
	uv run python 시각화.py

# ──────────────────────────────────────────────
# 4단계: Semantic Kernel + 행동 트리 통합
# ──────────────────────────────────────────────

sk-btree: ## [4] SK + BT 통합 - LLM 호출을 행동 트리 노드로 구성
	uv run python 시맨틱커널_행동트리.py

sk-btree2: ## [4] SK + BT 통합 v2 - 개선된 LLM 행동 트리 파이프라인
	uv run python 시맨틱커널_행동트리2.py

# ──────────────────────────────────────────────
# 5단계: 설계 원칙 (서브트리 재사용)
# ──────────────────────────────────────────────

재사용의미학: ## [5] 서브트리 재사용 - 공통 로직을 서브트리로 분리/조합
	uv run python 재사용의미학.py
